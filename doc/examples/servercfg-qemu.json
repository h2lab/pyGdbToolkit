{
  "gdb-path": "gdb-multiarch",
  "gdb-args": [],
  "ocd-path": "qemu-system-arm",
  "ocd-identifier": "qemu",
  "ocd-args": [
    "-M", "netduinoplus2",
    "-kernel", "firmware.elf",
    "-display", "none",
    "-serial", "none",
    "-monitor", "none",
    "-S",
    "-gdb", "tcp:{loopback}:{gdb_port}"
  ],
  "listen-address": "127.0.0.1:1234",
  "gdb-init": [
    "symbol-file firmware.elf",
    "set mem inaccessible-by-default off"
  ],
  "log-directory": ".pygdbserver-logs",
  "startup-timeout": 15
}
