{
    "gdb-path": "gdb-multiarch",
    "gdb-args": [],
    "ocd-path": "openocd",
    "ocd-args": [
        "-c", "bindto {loopback}",
        "-c", "gdb_port {gdb_port}",
        "-c", "telnet_port {telnet_port}",
        "-c", "tcl_port disabled",
        "-f", "interface/cmsis-dap.cfg",
        "-c", "adapter serial E6647C74034BC430",
        "-c", "adapter speed 5000",
        "-f", "target/rp2350.cfg"
    ],
    "listen-address": "localhost:1235",
    "gdb-init": [
        "set arch arm",
        "monitor reset halt",
        "set mem inaccessible-by-default off",
        "svd load"
    ],
    "log-directory": ".pygdbserver-logs",
    "startup-timeout": 15
}
