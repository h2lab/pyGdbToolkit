{
    "gdb-path": "gdb-multiarch",
    "gdb-args": [
        "-ex", "set architecture arm",
        "-ex", "set endian little"
    ],
    "ocd-path": "JLinkGDBServer",
    "ocd-args": [
        "-if", "JTAG",
        "-device", "MIMX8ML6_M7",
        "-speed", "1000",
        "-endian", "little",
        "-port", "{gdb_port}",
        "-swoport", "2332",
        "-telnetport", "{telnet_port}",
        "-localhostonly", "1"
    ],
    "listen-address": "localhost:1234",
    "gdb-init": [
        "monitor reset",
        "set mem inaccessible-by-default off"
    ],
    "log-directory": ".pygdbserver-logs",
    "startup-timeout": 15
}
