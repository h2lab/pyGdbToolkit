{
    "gdb-path": "gdb-multiarch",
    "gdb-args": [],
    "ocd-path": "pyocd",
    "ocd-args": [
        "gdbserver",
        "--port", "{gdb_port}",
        "--target", "stm32u5a5zjtxq",
        "-u", "{usb_serial}"
    ],
    "listen-address": "127.0.0.1:0",
    "gdb-init": [
        "set arch arm",
        "monitor reset halt",
        "set mem inaccessible-by-default off",
        "svd load"
    ],
    "log-directory": ".pygdbserver-logs",
    "startup-timeout": 15
}
